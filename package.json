{
  "name": "payload-sales-reports",
  "version": "1.0.1",
  "description": "Sales totals by period, product and customer for Payload ecommerce, as data and endpoints with no admin component required.",
  "keywords": [
    "payload",
    "payloadcms",
    "payload-plugin",
    "ecommerce",
    "reports",
    "analytics",
    "sales"
  ],
  "homepage": "https://github.com/Poseidonas/payload-sales-reports",
  "bugs": "https://github.com/Poseidonas/payload-sales-reports/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/Poseidonas/payload-sales-reports"
  },
  "license": "MIT",
  "author": "George Vasiliades (https://github.com/Poseidonas)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist",
    "lint": "eslint src test",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "22.19.9",
    "eslint": "9.39.1",
    "payload": "3.88.0",
    "rimraf": "6.0.1",
    "tsup": "8.5.0",
    "typescript": "5.7.2",
    "typescript-eslint": "8.46.4",
    "vitest": "4.0.18"
  },
  "peerDependencies": {
    "@payloadcms/plugin-ecommerce": ">=3.88 <4",
    "payload": ">=3.88 <4"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
